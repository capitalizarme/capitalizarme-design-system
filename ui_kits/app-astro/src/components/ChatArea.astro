---
// ChatArea — the main workspace pane for advisor threads. Composes InputBar (once, shared
// across advisor panels) and MessageBubble per message. Both advisor panels render server-side;
// the client script in pages/index.astro toggles which one is visible and appends new messages.
import InputBar from './InputBar.astro';
import MessageBubble from './MessageBubble.astro';
import { advisors, initialThreads } from '../data/advisors';
---
<div class="flex-1 flex flex-col min-w-0">
  {advisors.map((advisor, i) => (
    <div data-chat-panel={advisor.id} class="flex-1 flex-col" style={i === 0 ? 'display:flex' : 'display:none'}>
      <div class="flex items-center justify-between border-b border-gray-100 px-6 py-4">
        <p class="leading-tight">
          <span class="block font-display font-bold text-brand-navy">{advisor.name}</span>
          <span class="block text-sm text-brand-navy/60">{advisor.role}</span>
        </p>
        <a
          href="#"
          class="font-cta font-bold uppercase tracking-wider text-xs rounded-full border-2 border-brand-blue text-brand-blue px-6 py-2 hover:bg-brand-blue hover:text-white transition-all duration-300 ease-in-out"
        >
          Agenda tu reunión
        </a>
      </div>
      <div data-chat-messages={advisor.id} class="flex-1 overflow-y-auto px-6 py-4">
        {(initialThreads[advisor.id] ?? []).map((message) => (
          <MessageBubble from={message.from} text={message.text} />
        ))}
      </div>
    </div>
  ))}
  <InputBar />
</div>
